{
  "name": "hotel-aspect-ai-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Hotel Aspect AI desktop application for Windows and macOS",
  "main": "desktop/main.cjs",
  "scripts": {
    "desktop": "electron .",
    "desktop:dist:mac": "electron-builder --mac dmg zip",
    "desktop:dist:win": "electron-builder --win nsis",
    "desktop:dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.hotelaspect.qa",
    "productName": "Hotel Aspect AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "webapp",
        "to": "project/webapp",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "data/df/hotel_reviews.parquet",
        "to": "project/data/df/hotel_reviews.parquet"
      }
    ],
    "mac": {
      "identity": null,
      "category": "public.app-category.travel",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
